DATABASE_URL=postgres://bugtracker:CHANGE_ME@localhost:5432/bugtracker

# Attachments (S3 or any S3-compatible store). Leave S3_BUCKET empty to disable.
S3_BUCKET=
S3_REGION=us-east-1
# For R2 / MinIO / B2 etc. Leave empty for AWS. R2: https://<account_id>.r2.cloudflarestorage.com (region: auto)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=bug-tracker/
ATTACHMENT_MAX_MB=25

# Push notifications: a contact for browser push services (mailto: or https:).
# The VAPID keys are generated automatically and stored in the database.
VAPID_SUBJECT=mailto:you@example.com
