{
	"id": "/",
	"name": "Bugs",
	"short_name": "Bugs",
	"description": "Minimal bug & feature tracker",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"background_color": "#ffffff",
	"theme_color": "#ffffff",
	"categories": ["productivity", "developer"],
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
	],
	"shortcuts": [
		{
			"name": "Quick add",
			"url": "/?new=1",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
		},
		{ "name": "Inbox", "url": "/?inbox=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Capture", "url": "/capture", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
		{
			"name": "Dashboard",
			"url": "/dashboard",
			"icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
		}
	],
	"share_target": {
		"action": "/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "files",
					"accept": ["image/*", "video/*", "text/*", "application/pdf", "application/json", ".log", ".txt"]
				}
			]
		}
	}
}
